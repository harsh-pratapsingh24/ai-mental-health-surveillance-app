# Never commit your real .env file. Generate a unique secret for every deployment.
FLASK_ENV=development
FLASK_SECRET_KEY=replace-with-a-random-48-character-or-longer-secret
FORCE_HTTPS=false
PUBLIC_APP_URL=http://localhost:5000
# Optional: use when the frontend is hosted separately from this Flask API.
API_BASE_URL=

# Optional Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional companion providers — Groq is the currently implemented provider.
GROQ_API_KEY=gsk_replace_me
GROQ_TIMEOUT_SECONDS=12
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Production integration placeholders — no data is persisted or dispatched
# until their corresponding repository/worker adapters are explicitly enabled.
DATABASE_URL=postgresql://aegismind:replace_me@localhost:5432/aegismind
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
SENTRY_DSN=
TELE_MANAS_API_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Set this before exposing counselor endpoints. Send it only as the
# X-Counselor-Key request header from an authenticated clinician portal.
COUNSELOR_API_KEY=replace-with-a-long-random-value

# Public API protection (per client IP, in a single Flask process).
RATE_LIMIT_WINDOW_SECONDS=60
CHECKIN_RATE_LIMIT=10
CHAT_RATE_LIMIT=20
FORUM_RATE_LIMIT=8
MAX_REQUEST_BYTES=32768

# PWA Configuration (optional)
PWA_APP_NAME=AegisMind
PWA_APP_SHORT_NAME=AegisMind

# Audit Logging (enabled by default, disable for local dev if noisy)
AUDIT_LOG_ENABLED=true

# Database Migration (enable when ready to migrate from in-memory to PostgreSQL)
DB_MIGRATION_ENABLED=false
